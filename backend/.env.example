# Copy this file to .env and fill in real values. Never commit .env itself.

# Server
PORT=5000
NODE_ENV=development

# MongoDB
# Local dev:   mongodb://127.0.0.1:27017/terrarun
# Atlas:       mongodb+srv://<user>:<password>@<cluster>.mongodb.net/terrarun
MONGODB_URI=mongodb://127.0.0.1:27017/terrarun

# Frontend origin allowed to hit this API (CORS)
CLIENT_ORIGIN=http://localhost:5173

# --- Phase 1: JWT auth ---
# Generate distinct random strings for these, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

# --- Phase 1: Firebase Admin (phone-auth ID token verification) ---
# From a Firebase service-account JSON (Project settings > Service accounts >
# Generate new private key). See the setup comment block at the top of
# backend/src/controllers/authController.js for the full walkthrough.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Keep the literal \n sequences from the downloaded JSON — don't replace them
# with real newlines in this file.
FIREBASE_PRIVATE_KEY=

# --- Phase 11: Weekly email reports (Nodemailer) ---
# Any SMTP provider works: Gmail (with an App Password, not your normal
# password), Resend, Brevo, Mailtrap, or Ethereal (https://ethereal.email)
# for local testing without sending real mail. Leave these blank to run
# everything else normally — the weekly report job just logs "skipped, SMTP
# not configured" instead of crashing (see backend/src/utils/mailer.js).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=TerraRun <no-reply@terrarun.app>

# Used to build links inside the weekly report email (e.g. the "Open
# TerraRun" button, "manage email preferences"). Point this at your deployed
# frontend once you have one.
APP_BASE_URL=http://localhost:5173

# --- Added in later phases, listed here so you know what's coming ---
# (none pending right now)