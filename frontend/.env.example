# Copy to .env.local (Vite convention) and adjust as needed. Never commit
# real secrets — Firebase web config (Phase 1) is not secret, but keep this
# file as the source of truth for what env vars the frontend expects.

VITE_API_BASE_URL=http://localhost:5000/api

# --- Phase 1: Firebase Phone Auth (web config — not secret, safe to expose) ---
# From Firebase console > Project settings > General > Your apps > Web app.
# See the full setup walkthrough in backend/src/controllers/authController.js.
# Email/password auth works fine without these — only the Phone tab needs them.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
